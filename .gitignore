# Reference papers — copyright; cite in README/references instead
Paper/

# External repos — cloned locally, not submodules; see README for clone instructions
# (FlowDPS, DPS, DDNM, fastMRI reference code)
external/

# Data — never commit. fastMRI requires credentialed access (NYU application);
# each user downloads their own copy. Raw k-space volumes are 1–10 GB per file.
data/

# fastMRI raw k-space and any HDF5 — should live in data/ anyway, but belt-and-braces
# because a stray .h5 will blow past GitHub's 100 MB hard limit
*.h5
*.hdf5

# Pretrained generative priors — downloaded from upstream releases, not redistributed
checkpoints/
*.pt
*.pth
*.ckpt
*.safetensors

# Experiment outputs — regenerable from configs + fixed seeds
outputs/
runs/
results/
logs/

# Calibration artefacts — derived from data/, regenerable, and can be large
# (per-operator score caches, posterior sample banks)
cache/
*.npy
*.npz

# Weights & Biases
wandb/

# Python
__pycache__/
*.py[cod]
*.egg-info/
*.egg
.eggs/
dist/
build/
*.so

# Jupyter
.ipynb_checkpoints/

# Environment
.env
*.env
.venv/
venv/

# macOS
.DS_Store

# Figures generated by scripts — regenerable, not source.
# Figures hand-made for the manuscript belong in Paper/ or are force-added.
figures/*.png
figures/*.pdf

# blueprint docs — binary, revised in Word, not source (see D13)
*.docx
