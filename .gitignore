# Reference papers - copyright; cite in README/references instead
Paper/

# External repos - cloned locally, not submodules; see README for clone
# instructions (FlowDPS, DPS, DDNM, fastMRI reference code)
external/

# Data - never committed. fastMRI requires credentialed access (NYU
# application) and each user downloads their own copy. Currently ~74 GB of CT
# archives live here too, so this must exclude the whole tree: `git add data`
# will otherwise try to hash a 30 GB zip and hang. See
# Documentation/data_access.md.
# The whole tree is ignored: data/ carries no README of its own (D-025).
# LEADING SLASH IS LOAD-BEARING: a bare `data/` has no slash before its end, so
# git matches it at ANY depth and silently ignores `src/caliber/data/` as well.
# That is not hypothetical -- it blocked `src/caliber/data/splits.py` from ever
# being committed and broke every import in the package (D36).
/data/

*.h5
*.hdf5
*.mat
*.ismrmrd
*.zip
*.tar

# The fastMRI archives specifically. Named rather than left to `data/` because
# pushing these would breach the NYU Data Sharing Agreement signed to obtain
# them (redistribution is forbidden) — not merely bloat the repo. See
# GIT_RULES.md §15 and Documentation/data_access.md §6.
data/knee_singlecoil_val.tar
data/knee_singlecoil_test.tar
data/raw/fastmri/

# Score banks and run outputs - regenerated from configs + seeds.
runs/
outputs/
results/
logs/
score_banks/
*.parquet
!tests/fixtures/*.parquet

# Calibration artefacts - derived from data/, regenerable, and can be large
# (per-operator score caches, posterior sample banks)
cache/
*.npy
*.npz

# Model checkpoints - pretrained priors, downloaded from upstream releases
checkpoints/
*.pt
*.pth
*.ckpt
*.safetensors

# Weights & Biases
wandb/

# Python
__pycache__/
*.py[cod]
*.so
.venv/
venv/
.env
*.env
*.egg
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# Figures generated by scripts - regenerable, not source.
# Figures hand-made for the manuscript belong in Paper/ or are force-added.
figures/*.png
figures/*.pdf

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Course/planning docs kept locally, not in the repo.
Capstone_Blueprint_v3.docx
Computer_Vision_Weekly_Cards_MASTER.docx
# blueprint docs — binary, revised in Word, not source (see D13)
*.docx

# Local machine-migration notes and transfer bundle — personal, not source,
# never pushed (see MOVE_TO_COLLEGE_PC.md itself for why).
MOVE_TO_COLLEGE_PC.md
caliber-repo.bundle
*.bundle

# Local-only working rules. Personal working agreement, not project source.
GIT_RULES.md

# Superseded by Documentation/ on main (Track 1 merged the two folders). The
# local copy is kept on this machine as a working scratch area and is never
# pushed; all shared documentation lives in Documentation/.
docs/
